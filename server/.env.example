# ─────────────────────────────────────────────────────────────────────────────
#  Forum backend — bitta sozlama fayli
#
#  Nusxa oling va toʻldiring:
#      cp server/.env.example server/.env
#      chown php-dev:php-dev server/.env && chmod 600 server/.env
#
#  Bu fayl git'ga tushmaydi va serverdan tashqari hech qayerda turmaydi.
#  Deploy uni almashtirmaydi — bir marta toʻldirasiz, keyin unutasiz.
#
#  Qoidalar: har qator KEY=qiymat. Qavs ham, nuqtali vergul ham kerak emas.
#  Qatorni # bilan boshlasangiz — izoh. Qiymat boʻsh qolsa, standart qiymat
#  ishlaydi (pastda har birining yonida koʻrsatilgan).
#
#  Toʻldirilgandan keyin tekshirib olish:
#      php server/bin/doctor.php
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Majburiy ──────────────────────────────────────────────────────────────

# Adminka paroli — hash koʻrinishida. Parolning oʻzi hech qayerda saqlanmaydi.
#
# Hash yasash (parol ekranda ham, buyruqlar tarixida ham qolmaydi):
#     php server/bin/password.php
#
# Bu yerda nima yozilgan boʻlsa — oʻrnatishdagi dastlabki parol. Keyin
# adminkadan oʻzgartirilsa, yangisi server/data/admin.json ga tushadi va bu
# qator eʼtiborsiz qoladi. Yaʼni parolni bu fayldan qayta oʻqib olib
# boʻlmaydi — faqat yangisini qoʻyish mumkin.
#
# Boʻsh qolsa, adminka hech kimni kiritmaydi. Taxmin qilinadigan standart
# parol yoʻq.
ADMIN_PASSWORD_HASH=

# Sayt qaysi papkadan beriladi — index.html, assets/ va data/ turgan joy.
# Adminka data/*.json ni shu yerda yangilaydi, shuning uchun oʻzgarish darhol
# saytda koʻrinadi. PHP-FPM shu papkaning ichidagi data/ ga yozish huquqiga
# ega boʻlishi kerak.
#     standart: repo ichidagi site-2-silkroad/dist (faqat lokal ish uchun)
SITE_DIR=/var/www/forum/public

# Saytning tashqi manzili, oxirida / belgisi boʻlmasin.
# U faqat e-bilet QR kodining ichidagi havolaga kerak: beyj chop etilib
# binodan tashqariga chiqadi, demak undagi manzil tashqi manzil boʻlishi
# shart. Boʻsh qolsa — soʻrov kelgan host ishlatiladi.
SITE_URL=https://forum.example.uz

# Adminka sarlavhasida koʻrinadi. Test serverni jonlisidan ajratish uchun.
SITE_NAME=Tourism Investment Forum 2026


# ── 2. Maʼlumotlar ───────────────────────────────────────────────────────────

# Arizalar, overlay (adminkadagi oʻzgarishlar), bilet kaliti va parol shu
# papkada turadi. public/ ichida BOʻLMASIN. PHP-FPM yozadi, shuning uchun:
#     install -d -o php-dev -g php-dev -m 750 /var/www/forum/server/data
#     standart: server/data
DATA_DIR=/var/www/forum/server/data

# auto | sqlite | jsonl
#   auto   — pdo_sqlite bor boʻlsa SQLite, yoʻq boʻlsa oddiy matnli fayl
#   jsonl  — har doim matnli fayl: cat bilan oʻqiladi, wc -l bilan sanaladi
#     standart: auto
STORAGE=auto

# Har bir yangi ariza shu manzilga ham yuboriladi (serverning mail() si
# orqali). Boʻsh qolsa — hech narsa yuborilmaydi, ariza baribir saqlanadi.
NOTIFY_EMAIL=


# ── 3. Xavfsizlik ────────────────────────────────────────────────────────────

# HTTPS majburiymi. Sertifikat ishlayotganini tekshirgandan KEYIN 1 qiling —
# aks holda birinchi soʻrovning oʻzi cheksiz redirect'ga tushadi.
FORCE_HTTPS=0

# Adminka faqat shu IP manzillardan ochilsin. Vergul bilan ajratiladi,
# IPv4 uchun 10.0.0.0/8 koʻrinishidagi diapazon ham boʻladi.
# Boʻsh qolsa — hamma joydan ochiladi va parol yagona qulf boʻlib qoladi.
#     masalan: ADMIN_IP_ALLOW=84.54.0.0/16, 213.230.106.4
ADMIN_IP_ALLOW=

# Noto'g'ri parol necha marta kiritilgandan keyin manzil bloklanadi, va
# necha daqiqaga. Har takrorlangan blok muddati ikki barobar oshadi.
#     standart: 5 va 15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Sessiya qancha turadi: tegilmasa necha daqiqada, va umuman necha soatda
# yopiladi. Adminkada mehmonlarning telefon raqamlari koʻrinadi —
# ochiq qolgan sahifa oʻzi yopilsin.
#     standart: 30 va 12
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Bitta IP bir soatda nechta ariza yuborishi mumkin. Bitta ofisdan
# kelayotgan delegatsiya sezmaydigan, lekin robot sezadigan chegara.
#     standart: 20
RATE_LIMIT_PER_HOUR=20

# Brauzerdan ariza yuborishga ruxsat berilgan manzillar (CORS).
# Sayt ham, API ham bitta serverda boʻlsa — BOʻSH QOLDIRING: hech qanday
# CORS sarlavhasi yuborilmaydi va kerak ham emas.
# Sayt GitHub Pages'da turgan vaqtda esa:
#     ALLOWED_ORIGINS=https://fastsoftware-uz.github.io
ALLOWED_ORIGINS=
